{
  "name": "quality-gate-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Requirement Quality Gate before a fixed requirement-to-UML pipeline (SWD392 research prototype)",
  "engines": {
    "node": ">=23.6"
  },
  "scripts": {
    "data:build": "node scripts/build-requirements.ts",
    "test": "node --test \"tests/**/*.test.ts\"",
    "typecheck": "tsc -p .",
    "check": "npm run typecheck && npm test",
    "web": "node src/web/server.ts",
    "experiment": "node scripts/experiment.ts",
    "smoke": "node scripts/experiment.ts smoke",
    "smoke:mock": "node scripts/experiment.ts smoke --provider mock"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
