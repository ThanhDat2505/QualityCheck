# Copy to .env (never commit .env). Node reads it with: node --env-file=.env ...
# Claude API key (or run `ant auth login` once; the SDK picks up the profile automatically)
ANTHROPIC_API_KEY=
# anthropic (default) or mock (offline tests only; mock results are not experimental data)
LLM_PROVIDER=anthropic
# Frozen experimental configuration - change only before the pilot freeze
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=medium
# Optional: where LLM call logs go (default experiments/logs/llm-calls.jsonl)
# LLM_LOG_FILE=
